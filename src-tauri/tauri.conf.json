{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DClutter",
  "version": "0.1.0",
  "identifier": "dev.djenriquez.DClutter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DClutter",
        "width": 716,
        "height": 880,
        "minWidth": 520,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Dexter Jethro Enriquez",
    "copyright": "Copyright 2026 Dexter Jethro Enriquez",
    "shortDescription": "Swipe to clean your files."
  }
}
